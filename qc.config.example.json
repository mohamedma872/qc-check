{
  "$schema": "./qc.config.schema.json",
  "project": {
    "name": "Example App",
    "reportsDir": "qc-reports",
    "locales": [
      "en"
    ],
    "rtlLocales": [],
    "commitReports": false
  },
  "tracker": {
    "kind": "none",
    "ticketPattern": "[A-Z]+-[0-9]+",
    "site": "",
    "projectKey": "",
    "tools": {
      "getIssue": "",
      "addComment": "",
      "addLabels": "",
      "uploadAttachment": ""
    },
    "passLabel": "QC-Agent-Pass",
    "blockedLabel": "BE-Blocking",
    "publish": false
  },
  "agent": {
    "kind": "claude",
    "command": "",
    "extraArgs": [],
    "headless": false,
    "timeoutMinutes": 180
  },
  "repo": {
    "defaultBranch": "main",
    "host": "",
    "remote": "origin",
    "bitbucket": { "emailEnv": "BITBUCKET_EMAIL", "tokenEnv": "BITBUCKET_API_TOKEN" }
  },
  "app": {
    "defaultFlavor": "staging",
    "androidActivity": "com.example.app.MainActivity",
    "envBanner": "",
    "build": {
      "android": "yarn android:{flavor}",
      "ios": "yarn ios:{flavor}",
      "worktreeDir": "",
      "copyFiles": ["env/{flavor}.json"]
    },
    "flavors": {
      "staging": {
        "androidPackage": "com.example.app.staging",
        "iosBundleId": "com.example.app.staging"
      },
      "production": {
        "androidPackage": "com.example.app",
        "iosBundleId": "com.example.app"
      }
    }
  },
  "devices": {
    "android": {
      "enabled": true,
      "avd": "QC_Phone_API36",
      "udid": "",
      "deviceName": "Android Phone"
    },
    "android_tablet": {
      "enabled": false,
      "avd": "",
      "udid": "",
      "deviceName": "Android Tablet"
    },
    "ios": {
      "enabled": false,
      "deviceName": "iPhone 16",
      "udid": ""
    },
    "appium": {
      "host": "127.0.0.1",
      "port": 4723,
      "newCommandTimeout": 900
    }
  },
  "backend": {
    "enabled": true,
    "defaultEnv": "staging",
    "baseUrls": {
      "staging": "https://api.staging.example.com",
      "production": ""
    },
    "healthPath": "/health",
    "auth": {
      "path": "/auth/login",
      "method": "POST",
      "usernameField": "username",
      "passwordField": "password",
      "tokenPath": "data.accessToken",
      "extraBody": {}
    },
    "headers": {},
    "smokePath": "/health",
    "protectedEnvs": []
  },
  "codeMap": {
    "sourceDir": "src",
    "navigationGlob": "src/navigation/*.tsx",
    "translationsDir": "src/translations",
    "apiServicesGlob": "src/api/services/**",
    "mutationsGlob": "src/hooks/mutations/**",
    "queriesGlob": "src/hooks/queries/**",
    "utilsGlob": "src/utils/**",
    "validationGlob": "src/validation/**",
    "testCommand": "yarn jest",
    "lintCommand": "yarn lint",
    "typecheckCommand": "npx tsc --noEmit --skipLibCheck",
    "testsGitignored": false
  },
  "review": {
    "lintCommand": "",
    "layers": [
      {
        "name": "screens-use-hooks",
        "files": "src/screens/**",
        "mustNotImport": ["src/api/services/**"],
        "why": "screens go through the query/mutation hooks, not the API services."
      }
    ],
    "disable": [],
    "maxFileLines": 600,
    "maxFunctionLines": 80,
    "httpClientDirs": ["src/api"]
  },
  "budget": {
    "currency": "USD",
    "runCap": 30
  },
  "perf": {
    "maxJankPct": 10,
    "maxP90Ms": 32,
    "maxMemGrowthMb": 25,
    "maxColdStartMs": 4000,
    "leakLoopTimes": 10
  },
  "credentialsFile": "qc.credentials.js"
}
