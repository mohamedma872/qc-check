{
  "name": "qc-check",
  "version": "1.0.0",
  "description": "Run mobile QC on a real device from one CLI. An AI agent drives your app through Appium, verifies the backend contract, and produces an evidence-backed report. Install with a shell script, no npm required.",
  "bin": {
    "qc-check": "bin/qc-check.js"
  },
  "files": [
    "bin/",
    "cli/",
    "runtime/",
    "skill/",
    "agents/",
    "docs/",
    "qc-check",
    "install.sh",
    "qc.config.example.json",
    "qc.config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "check:leaks": "node test/no-private-refs.js"
  },
  "keywords": [
    "qc",
    "cli",
    "appium",
    "mobile-testing",
    "android",
    "ios",
    "react-native",
    "ai-agent",
    "claude-code",
    "codex",
    "qa-automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "webdriverio": ">=8"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedma872/qc-check.git"
  },
  "license": "MIT"
}
